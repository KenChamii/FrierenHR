# Copy to .env and fill in. .env is ignored by git and must never be committed.

# Database
# Host-side port. 5433 by default to avoid a natively installed PostgreSQL on 5432.
DB_PORT=5433
POSTGRES_DB=frierenhr
POSTGRES_USER=frierenhr
POSTGRES_PASSWORD=

# Token signing. At least 32 characters. Generate one with:
#   openssl rand -base64 48
JWT_KEY=
JWT_ISSUER=FrierenHR
JWT_AUDIENCE=FrierenHR

# Where the browser reaches the app. Used for the CORS allow-list.
WEB_PORT=8080
CORS_ORIGIN=http://localhost:8080

# Demo data. Seeds one company with employees, shifts and history on an EMPTY database.
# Leave DEMO_SEED=false for anything holding real data.
DEMO_SEED=false
DEMO_PASSWORD=
